workbench.bizfin.test {
  tls /certs/bizfin.local.pem /certs/bizfin.local-key.pem
  reverse_proxy host.docker.internal:1420
}

# Desktop POC only: WKWebView cannot use a CA trusted only in the developer's
# login keychain. Keep browser authorization on HTTPS and proxy only the public
# metadata/JWKS plus PKCE-protected public-client endpoints over loopback.
http://localhost, http://127.0.0.1 {
  @token path /_pacioli_oidc/token/
  handle @token {
    rewrite * /application/o/token/
    reverse_proxy server:9000 {
      header_up Host auth.bizfin.localhost
      header_up X-Forwarded-Host auth.bizfin.localhost
      header_up X-Forwarded-Proto https
    }
  }

  @userinfo path /_pacioli_oidc/userinfo/
  handle @userinfo {
    rewrite * /application/o/userinfo/
    reverse_proxy server:9000 {
      header_up Host auth.bizfin.localhost
      header_up X-Forwarded-Host auth.bizfin.localhost
      header_up X-Forwarded-Proto https
    }
  }

  @jwks path /_pacioli_oidc/workbench/jwks/
  handle @jwks {
    rewrite * /application/o/workbench/jwks/
    reverse_proxy server:9000 {
      header_up Host auth.bizfin.localhost
      header_up X-Forwarded-Host auth.bizfin.localhost
      header_up X-Forwarded-Proto https
    }
  }
}
