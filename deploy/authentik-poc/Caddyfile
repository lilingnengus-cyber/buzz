auth.bizfin.localhost {
  tls /certs/bizfin.local.pem /certs/bizfin.local-key.pem
  reverse_proxy server:9000
}

business.bizfin.localhost {
  tls /certs/bizfin.local.pem /certs/bizfin.local-key.pem
  @gateway path /api/me /api/identity-bindings/* /api/embed-sessions* /api/session /api/logout /api/logout/* /api/oidc/backchannel-logout /embed/bootstrap
  handle @gateway {
    reverse_proxy business-auth-gateway:3100
  }
  @business_core path /api/v1/*
  handle @business_core {
    reverse_proxy host.docker.internal:3110
  }
  handle {
    reverse_proxy host.docker.internal:4174
  }
}

workbench.bizfin.localhost {
  tls /certs/bizfin.local.pem /certs/bizfin.local-key.pem
  reverse_proxy host.docker.internal:1420
}

